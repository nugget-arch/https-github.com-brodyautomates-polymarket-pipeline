# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-...

# Polymarket CLOB API (optional — for live trading)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=

# Twitter API v2 (optional — real-time news stream)
TWITTER_BEARER_TOKEN=

# Telegram Bot (optional — channel monitoring)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_IDS=

# NewsAPI.org (optional — broader news coverage)
NEWSAPI_KEY=

# Pipeline Settings
DRY_RUN=true
MAX_BET_USD=25
DAILY_LOSS_LIMIT_USD=100
EDGE_THRESHOLD=0.10

# V2 Settings
MAX_VOLUME_USD=500000
MIN_VOLUME_USD=1000
MATERIALITY_THRESHOLD=0.6
SPEED_TARGET_SECONDS=5

# --- PocketOption bot (pocketoption/) ---
# Market
PO_SYMBOL=BTCUSDT
PO_TIMEFRAME=60          # seconds per candle (60/300/900/1800/3600)
PO_EXPIRY_CANDLES=1      # option expiry, in candles
PO_PAYOUT=0.85          # broker payout fraction (e.g. 0.85 = 85%)
# Strategy
PO_REGIME=trend         # trend | reversion
PO_MIN_CONFIDENCE=0.6
# Risk management
PO_START_BALANCE=1000
PO_STAKE_FRACTION=0.02  # 2% of balance per trade
PO_DAILY_LOSS_PCT=0.10
PO_DAILY_PROFIT_PCT=0.20
PO_MAX_LOSSES=4
PO_MARTINGALE=false     # keep false — martingale does NOT create edge
# Execution (keep PO_LIVE=false until you have implemented + validated a broker)
PO_LIVE=false
PO_POLL_SECONDS=5
POCKETOPTION_SSID=
