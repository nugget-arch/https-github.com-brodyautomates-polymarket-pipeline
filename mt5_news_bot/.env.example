# MetaTrader 5 account
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=ICMarkets-Demo
MT5_TERMINAL_PATH=

# Strategy timing
SECONDS_BEFORE_NEWS=5
ORDER_EXPIRY_SECONDS=120
POST_NEWS_TIMEOUT_SECONDS=30

# Risk settings
STRADDLE_PIPS=10
STOP_LOSS_PIPS=15
TAKE_PROFIT_PIPS=30
LOT_SIZE=0.10
MAX_SPREAD_PIPS=3
MAX_SLIPPAGE_PIPS=10

# Safety
DRY_RUN=true
MAX_TRADES_PER_DAY=3
DAILY_LOSS_LIMIT_USD=100

# Economic calendar (optional — free tier at https://finnhub.io)
FINNHUB_API_KEY=
