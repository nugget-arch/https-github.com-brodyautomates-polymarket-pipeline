# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Secret for signing session cookies. GENERATE YOUR OWN: `openssl rand -hex 32`
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
# Comma-separated origins allowed by CORS (restrictive by default)
CORS_ORIGINS=http://localhost:3000

# --- Database (operational) ---
# In Docker Compose the host is `db`; locally use `localhost`.
DATABASE_URL=postgresql+asyncpg://cqb:cqb@localhost:5432/cqb
# Tests use an in-memory/sqlite DB automatically; no need to set this for tests.

# --- Redis (real-time / rate-limit) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / single-user bootstrap ---
# On first boot an admin user is created from these if the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please
SESSION_TTL_MINUTES=720
RATE_LIMIT_PER_MINUTE=120

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# --- Execution safety (do not change) ---
# Hard guard: real-money execution is disabled in code regardless of this value.
EXECUTION_ENABLED=false
